dados <- readxl::read_xls('ch06_Vineyards_sharpe2011_p189.xls')
names(dados)
names(dados) <- c('local', 'tam', 'preco')
head(dados)
boxplot(preco ~ local, data=dados,
xlab = 'Localização', ylab = 'Preço da caixa (dólares)')
grid()
boxplot(preco ~ local, data=dados,
xlab = 'Localização', ylab = 'Preço da caixa (dólares)', pch='*')
boxplot(preco ~ local, data=dados,
xlab = 'Localização', ylab = 'Preço da caixa (dólares)', pch='*', cex=2)
grid()
boxplot(preco ~ local, data=dados,
xlab = 'Localização', ylab = 'Preço da caixa (dólares)', pch='*', cex=3)
grid()
png(file="graficos_vinhedos.png", width=1200, height=800, res = 200)
boxplot(preco ~ local, data=dados,
xlab = 'Localização', ylab = 'Preço da caixa (dólares)', pch='*', cex=3)
grid()
dev.off()
figure()
plot()
