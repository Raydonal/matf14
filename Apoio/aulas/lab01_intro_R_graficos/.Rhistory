mean(Dallas),
sd(Dallas),
)
dados %>% select(Dallas) %>% summarise(
mean(Dallas),
median(Dallas),
sd(Dallas),
min(Dallas),
max(Dallas),
quantile(Dallas)
)
dados %>% summarise(
mean(Dallas),
median(Dallas),
sd(Dallas),
min(Dallas),
max(Dallas),
quantile(Dallas)
)
class(dados)
dados %>% summarise(
mean(Dallas),
median(Dallas),
sd(Dallas),
min(Dallas),
max(Dallas)
)
dados %>% summarise(
mean(Dallas),
median(Dallas),
sd(Dallas),
min(Dallas),
max(Dallas),
quantile(.25, Dallas)
)
dados %>% summarise(
mean(Dallas),
median(Dallas),
sd(Dallas),
min(Dallas),
max(Dallas),
quantile(Dallas, 0.25)
)
dados %>% summarise(
media = mean(Dallas),
mediana = median(Dallas),
dp = sd(Dallas),
min = min(Dallas),
max = max(Dallas),
Q1 = quantile(Dallas, 0.25),
Q3 = quantile(Dallas, 0.75)
) %>% as.data.frame()
dados %>% summarise(
