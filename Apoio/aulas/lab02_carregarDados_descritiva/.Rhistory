main = 'Faturamento das empresas', col='blue',
ylab = 'Frequencia', xlab = 'Faturamento')
hist(empresas$faturamento99, col='magenta',
density = 10, add = TRUE)
legend('topright',title='Anos',legend=c('1998','1999'),
fill = c('blue', 'magenta'))
summary(empresas$faturamento98)
summary(empresas$faturamento99)
f98 = empresas$faturamento98
sd(f98)
sd(f98)/mean(f98)
f99 = empresas$faturamento99
sd(f99)
sd(f99)/mean(f99)
x = c(2, 20, 30, 25, 45, 100)
boxplot(empresas$idade, xlim = c(0.7, 1.3), ylim=c(0,50),
main="Idade", ylab="Tempo")
text(0.75, quantile(empresas$idade, 0.25), 'Q1')
text(0.75, quantile(empresas$idade, 0.5), 'Q2')
text(0.75, quantile(empresas$idade, 0.75), 'Q3')
dif_interquartil <- quantile(empresas$idade, 0.75) - quantile(empresas$idade, 0.25)
#text(0.75, quantile(empresas$tempo_existencia, 0.75) + 1.5*dif_interquartil, 'LS')
#text(0.75, quantile(empresas$tempo_existencia, 0.25) - 1.5*dif_interquartil, 'LS')
text(0.75, max(empresas$idade), 'LS')
text(0.75, min(empresas$idade), 'LI')
boxplot(empresas$faturamento98,
empresas$faturamento99,
main = 'Faturamento',
names = c('1998', '1999'), ylab="Faturamento")
plot(empresas$faturamento98,
empresas$faturamento99,
xlab="Faturamento 1998", ylab="Faturamento 1999")
cor(empresas$faturamento98, empresas$faturamento99)
